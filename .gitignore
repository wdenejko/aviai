# ── Python / uv ──────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.hypothesis/
.ipynb_checkpoints/

# ── macOS ────────────────────────────────────────────────────────────────────
.DS_Store

# ── Data zones (see projects/avtext/data/README.md) ──────────────────────────
# Rule from the plan: data never lives in git EXCEPT tiny committed anchors
# (manifests, frozen eval JSONL, gold seeds). We ignore the bulk zones and then
# force-add the small committed files with a leading '!'.
projects/avtext/data/raw/
projects/avtext/data/processed/
projects/avtext/data/reference/
projects/avtext/data/third_party/
projects/avtext/data/gold/
!projects/avtext/data/README.md
!projects/avtext/data/manifest.json

# dsbench targeted-SFT data (ADR-004): generators are committed, the generated
# JSONL are regenerable artifacts (Target C costs GPU hours, so it is persisted
# here rather than only in scratch) — ignore the bulk by pattern (so the tracked
# provenance anchors README.md + manifest.json in the same dir stay trackable).
projects/dsbench/data/sft/*.jsonl

# dsbench battery items (ADR-001 Gate 2): public benchmarks plus gated GPQA, whose terms forbid
# republishing its examples. A local copy for the decontamination gate (ADR-004 Revision 2);
# the source of truth is the battery run on dashi. Never committed.
projects/dsbench/data/battery/
projects/dsbench/data/sft/*.report.json
# per-gate data zone: symlinks into the ignored pools (a trailing '#' is NOT a comment here)
projects/dsbench/data/sft/gate2/
# Target C's volume run (patches/target_c_volume_mac.sh): rows, failures, reports and logs
projects/dsbench/data/sft/rev2_target_c/
# Target A's volume items (target_a_hints volume-items: ta_plain, ta_cells), and the recall
# items and checked replies the generation brings back
projects/dsbench/data/sft/rev2_target_a/
# Revision 2's single-turn generation brought back from the box: the replies and their checks
projects/dsbench/data/sft/rev2_generation/
# The Target A test (sftgen/target_a_eval.py): its items, regenerable from the seed (the manifest
# beside the directory holds their sha256), and the replies and checks brought back from the box
projects/dsbench/data/sft/rev2_target_a_test/
# SynSQL's SQLite databases, extracted from its databases.zip (sftgen/synsql.py)
projects/dsbench/data/synsql/

# Frozen eval sets and run reports ARE committed (reproducibility contract),
# so they are intentionally NOT ignored here.

# ── Models / weights (never in git — pull via HF/GGUF) ───────────────────────
*.gguf
*.safetensors
*.bin
*.pt
adapters/

# ── Experiment tracking ──────────────────────────────────────────────────────
wandb/
