diff --git a/tools/aiter_gmm_heuristics.py b/tools/aiter_gmm_heuristics.py
index 72639fc..36b6e2d 100644
--- a/tools/aiter_gmm_heuristics.py
+++ b/tools/aiter_gmm_heuristics.py
@@ -189,6 +189,13 @@ _PTGMM_CONFIGS: dict[tuple[str, int, int, int], ConfigValues] = {
 }
 
 
+# dashi seq4096 branch (2026-09-28): 32,768 routed rows = batch-1 seq-4096 x top-8. Reuse each
+# 16,384-row Qwen config (the recipe's moe_gmm_configs.py gets the same entries).
+for _table in (_GMM_CONFIGS, _PTGMM_CONFIGS):
+    for _key, _values in list(_table.items()):
+        if _key[0] == "qwen-learned" and _key[1] == 16384:
+            _table.setdefault((_key[0], 32768, *_key[2:]), _values)
+
 def _config(values: ConfigValues) -> dict[str, int]:
     return dict(zip(_CONFIG_KEYS, values, strict=True))
 
