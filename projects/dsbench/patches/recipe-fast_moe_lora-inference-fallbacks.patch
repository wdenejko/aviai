+# (prior, rows, K, N) shapes with no tuned AITER GMM config. moe_gmm_configs.py is a measured
+# table covering the TRAINING geometry, and it fails closed on anything else -- which blocks
+# inference, where the routed row count follows the prompt/decode length. The LoRA factors are dense
+# BF16 (unlike the packed base weights), so a plain grouped matmul is an exact substitute; it is only
+# used when autograd is off, because a tuned-config miss during TRAINING is a real bug, not
+# something to silently paper over.
+_GMM_UNTUNED = set()
+
+
+def _torch_grouped_mm(
+    lhs: torch.Tensor, rhs: torch.Tensor, group_sizes: torch.Tensor
+) -> torch.Tensor:
+    """Grouped matmul over rows that are already ordered by expert group."""
+    out = lhs.new_zeros((lhs.shape[0], rhs.shape[-1]))
+    start = 0
+    for expert, count in enumerate(group_sizes.tolist()):
+        if count <= 0:
+            continue
+        end = start + count
+        out[start:end] = lhs[start:end] @ rhs[expert].to(lhs.dtype)
+        start = end
+    return out
+
