              "id": "em7JrfQNuMjf1mR0L5HqYxNFZjYDieGi",
              "name": "bash",
              "arguments": {
                "command": "run_sql \"\nINSERT INTO prob_de_hub_daily.hub_daily (iata, day, n_dep, avg_dep_delay, n_metar)\nSELECT\n    h.iata,\n    d.day,\n    COALESCE(dep.n_dep, 0) AS n_dep,\n    ROUND(dep.avg_dep_delay, 2) AS avg_dep_delay,\n    COALESCE(met.n_metar, 0) AS n_metar\nFROM\n(\n    SELECT iata FROM aviation.airports WHERE iata IN ('ATL','ORD','DFW','DEN','LAX')\n) h\nCROSS JOIN\n(\n    SELECT day FROM (\n        SELECT toDate('2026-06-01') AS day UNION ALL\n        SELECT day + 1 FROM system.numbers WHERE day < 30\n    )\n) d\nLEFT JOIN\n(\n    SELECT Origin AS iata, toDate(Flights.FlightDate) AS day,\n           count() AS n_dep, avg(DepDelayMinutes) AS avg_dep_delay\n    FROM aviation.flights Flights\n    WHERE Origin IN ('ATL','ORD','DFW','DEN','LAX')\n      AND Flights.FlightDate >= '2026-06-01' AND Flights.FlightDate < '2026-07-01'\n    GROUP BY Origin, day\n) dep ON dep.iata = h.iata AND dep.day = d.day\nLEFT JOIN\n(\n    SELECT a.iata, toDate(m.valid_utc) AS day, count() AS n_metar\n    FROM aviation.metar m\n    JOIN aviation.airports a ON a.icao = m.station\n    WHERE a.iata IN ('ATL','ORD','DFW','DEN','LAX')\n      AND toDate(m.valid_utc) >= '2026-06-01' AND toDate(m.valid_utc) < '2026-07-01'\n    GROUP BY a.iata, day\n) met ON met.iata = h.iata AND met.day = d.day\n\""
              }
            }
          ],
